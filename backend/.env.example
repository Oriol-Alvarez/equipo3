# Variables de configuración del entorno para Sonrisas Backend
# En desarrollo local con Docker Compose, DATABASE_URL y S3_ENDPOINT se inyectan automáticamente.
JWT_SECRET=super-secret-jwt-key-for-sonrisas-app-tc2007b-change-this-in-production
CODIGO_PROFESOR=sonrisas-docente-2026
ACCESS_TTL_S=86400
REFRESH_TTL_S=604800

# Almacén de objetos compatible con S3 (RustFS)
S3_ACCESS_KEY=sonrisas-admin
S3_SECRET_KEY=sonrisas-secret-key-12345678
S3_BUCKET=sonrisas
S3_ENDPOINT=http://localhost:9000

# Notificaciones push (opcional). Copia el JSON de la cuenta de servicio de Firebase a
# backend/secretos/firebase.json y descomenta la línea. Sin esto no se mandan push.
# FIREBASE_CREDENTIALS=/code/secretos/firebase.json

# Síntesis del resumen semanal con Inteligencia Artificial (opcional)
# Obtén tu API key gratuita de Gemini en https://aistudio.google.com/
# GEMINI_API_KEY=tu-api-key-de-gemini
# o bien usando OpenAI:
# OPENAI_API_KEY=tu-api-key-de-openai

# Cloudflare Tunnel con dominio propio (obtenido de Cloudflare Zero Trust)
# CLOUDFLARE_TUNNEL_TOKEN=tu-token-aqui

